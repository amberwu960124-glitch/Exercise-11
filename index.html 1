<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <title>Exercise 11</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }

        h1 {
            font-size: 24px;
            font-weight: normal;
            border: 2px solid #8fbc8f;
            background-color: #f4f9f4;
            padding: 5px 12px;
            margin-bottom: 15px;
            display: inline-block;
        }

        h2 {
            font-size: 20px;
            font-weight: normal;
            border: 2px solid #e5c158;
            padding: 5px 12px;
            margin-bottom: 15px;
            display: inline-block; 
        }

        h3 {
            font-size: 16px;
            font-weight: normal;
            text-align: right;
            border-bottom: 2px solid #708090;
            padding-bottom: 5px;
            width: 100%;
        }
    </style>
</head>
<body>

    <div><h1>This is heading 1</h1></div>
    <div><h2>This is heading 2</h2></div>
    <h3>This is heading 3</h3>

</body>
</html>
